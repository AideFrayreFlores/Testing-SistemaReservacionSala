        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert registro: reservacion creada (HTTP 302)" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="assert_perf02_302">302</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">El registro no redirigio con 302: formulario invalido (sala/fecha/horario/proposito), traslape con datos previos, sesion perdida o CSRF invalido. Revisa la etiqueta 00 formulario y la base de datos local.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
