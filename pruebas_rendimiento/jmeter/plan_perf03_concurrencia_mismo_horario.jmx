        </HTTPSamplerProxy>
        <hashTree>
          <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Barrera: las 2 solicitudes del mismo horario salen juntas" enabled="true">
            <intProp name="groupSize">2</intProp>
            <longProp name="timeoutInMs">30000</longProp>
          </SyncTimer>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Etiquetar la muestra con ronda y fecha" enabled="true">
            <stringProp name="cacheKey"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">prev.setSampleLabel('PERF-03 POST ronda ' + vars.get('ronda') + ' ' + vars.get('fecha') + ' 08:00-09:00 (medido)')
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert PERF-03: 302 aceptada o 200 rechazo por traslape; otra cosa es error" enabled="true">
            <stringProp name="cacheKey"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def codigo = prev.getResponseCode()
def cabeceras = prev.getResponseHeaders() ?: ''
def cuerpo = prev.getResponseDataAsString() ?: ''
def aceptada = (codigo == '302') &amp;&amp; cabeceras.contains('/reservaciones/')
def rechazo = (codigo == '200') &amp;&amp; cuerpo.contains('disponible en el horario solicitado')
if (aceptada) {
    prev.setResponseMessage('ACEPTADA_302')
} else if (rechazo) {
    prev.setResponseMessage('RECHAZO_TRASLAPE_200')
} else {
    prev.setResponseMessage('INESPERADA_' + codigo)
    AssertionResult.setFailureMessage('Resultado inesperado en PERF-03: HTTP ' + codigo + ' sin 302 a /reservaciones/ ni 200 con rechazo por traslape. Revisa sesion, CSRF, datos, timeout o el control de concurrencia; un rechazo esperado no debe fallar.')
    AssertionResult.setFailure(true)
}
