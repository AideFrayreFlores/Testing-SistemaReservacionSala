<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="PERF-03 - concurrencia legitima sobre el mismo horario (2 hilos, 10 rondas)" enabled="true">
      <stringProp name="TestPlan.comments">PERF-03: 10 repeticiones controladas. En cada ronda dos solicitudes normales y autenticadas piden exactamente el mismo horario (misma sala, misma fecha y mismo bloque de 08:00 a 09:00). Un Synchronizing Timer con groupSize=2, hijo unicamente del POST medido, libera ambas peticiones juntas; el control de concurrencia de la aplicacion debe aceptar una (HTTP 302 a /reservaciones/) y rechazar la otra (HTTP 200 con el mensaje de traslape), sin persistir duplicados. Las dos filas del CSV por ronda son identicas y cada hilo consume una, de modo que ambos hilos piden la misma ranura aunque el orden de lectura del CSV varie. Cada ronda usa una fecha distinta (fecha_base + dias_offset), asi que hay 10 ranuras distintas y desechables; no se borra nada. La fecha se calcula como fecha_base (propiedad -J, por defecto hoy+60 dias) + dias_offset y se envia en ISO YYYY-MM-DD. El proposito persistido es 'Reserva PERF-03 ronda RR de NN AAAA-MM-DD 08:00-09:00' con RR = ronda y NN = valor de -Jrondas (10 por defecto), lo que permite cruzar el JTL, la base de datos y la auditoria de la corrida. El rechazo esperado por traslape NO se marca como error: la asercion JSR223 acepta 302 (ganadora) o 200 con el texto de traslape (perdedora) y solo falla ante HTTP o texto inesperados. El login y el GET del formulario no se miden y llevan etiqueta 00. Solo Django local (127.0.0.1); no hay destinos remotos. La clave no esta en el plan: se lee de la variable de entorno JMETER_CLAVE. Dos hilos como maximo: el Synchronizing Timer usa groupSize=2, no cambies el numero de hilos sin cambiarlo.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables del plan" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">127.0.0.1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(puerto,8000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RONDAS" elementType="Argument">
            <stringProp name="Argument.name">RONDAS</stringProp>
            <stringProp name="Argument.value">${__P(rondas,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RAMP" elementType="Argument">
            <stringProp name="Argument.name">RAMP</stringProp>
            <stringProp name="Argument.value">${__P(ramp,0)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RUTA_LOGIN" elementType="Argument">
            <stringProp name="Argument.name">RUTA_LOGIN</stringProp>
            <stringProp name="Argument.value">/usuarios/login</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RUTA_FORMULARIO" elementType="Argument">
            <stringProp name="Argument.name">RUTA_FORMULARIO</stringProp>
            <stringProp name="Argument.value">/reservaciones/nueva</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
